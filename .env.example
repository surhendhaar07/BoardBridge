APP_NAME=BoardBridge
ENVIRONMENT=local

# Database (PostgreSQL with pgvector)
# Local development: postgresql://app:app@localhost:5432/rag
# Docker Compose: postgresql://app:app@db:5432/rag
DATABASE_URL=

LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5

LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0

COST_LOG_PATH=logs/cost.jsonl

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
